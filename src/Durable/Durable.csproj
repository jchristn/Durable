<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<IsAotCompatible>true</IsAotCompatible>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<ApplicationIcon>logo.ico</ApplicationIcon>
		<DocumentationFile>Durable.xml</DocumentationFile>
		<Title>Durable</Title>
		<Version>0.5.0</Version>
		<Authors>jchristn,joshclopton</Authors>
		<Description>A lightweight .NET ORM with full LINQ support: the backend-neutral core of Durable (IRepository, IQueryBuilder, attribute and convention mapping, transactions, optimistic concurrency, the neutral query model and RepositoryBase for non-SQL backends). Trim- and Native AOT-compatible. Use with Durable.Sqlite, Durable.Postgres, Durable.MySql, Durable.SqlServer, Durable.InMemory, Durable.LiteDb or Durable.LiteGraph.</Description>
		<Copyright>(c)2025 Durable Community</Copyright>
		<PackageProjectUrl>https://github.com/jchristn/durable</PackageProjectUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/jchristn/durable</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>mysql;linq;postgres;orm;database;sqlite;postgresql;sqlserver;ef;sql</PackageTags>
		<PackageReleaseNotes>0.5.0 (breaking): Native AOT and trimming support (DynamicallyAccessedMembers annotations, no runtime codegen under AOT, DurableJson for source-generated JSON, EntityMetadata.RequiredMemberTypes); QueryEvaluator&lt;TRow&gt; public for non-SQL backends; TransactionScope renamed AmbientTransactionScope (IAsyncDisposable; Durable does not participate in System.Transactions); ImprovedMergeChangesResolver folded into MergeChangesResolver with MergeConflictBehavior; resolver async methods take a CancellationToken; [VersionColumn] infers its type, RowVersion renamed BinaryCounter; ReadFirstOrDefault and BatchDelete removed (use ReadFirst, DeleteMany); include-query switches and RepositoryExtensions removed (use the *WithQuery methods); RepositorySettings/RepositoryType moved to Durable.Sql. See CHANGELOG.md for migration hints.</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="logo.ico" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\assets\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="buildTransitive\Durable.props">
			<Pack>True</Pack>
			<PackagePath>buildTransitive\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Durable.xml">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
